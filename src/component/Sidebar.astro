---

<aside id="logo-sidebar" class="fixed top-0 left-0 z-40 w-72 h-screen pt-24 transition-transform -translate-x-full bg-white border-r border-gray-200 sm:translate-x-0 dark:bg-gray-800 dark:border-gray-700" aria-label="Sidebar">
  <div class="h-full px-3 pb-4 overflow-y-auto bg-white dark:bg-gray-800">
     <ul class="space-y-2 font-medium">
        {
          listButton.map((button) => (
            <li>
              <a href={button.href} class="flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
                <img src={button.icon} alt={`${button.name} icon`} class="w-5 h-5" />
                <span class="ms-3">{ button.name }</span>
                {button.new && <span class="ms-auto px-2 text-center text-xs text-white bg-red-500 rounded-full font-bold uppercase animate-pulse">New</span>}
              </a>
            </li>
          ))
        }
     </ul>
  </div>
</aside>